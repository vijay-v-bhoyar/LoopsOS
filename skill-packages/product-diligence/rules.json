{
  "_doc": "Machine source of truth for product-diligence verdict derivation. SKILL.md tables are the human mirror; this file is authoritative. Predicate names are interpreted by scripts/derive.py; the set is closed.",
  "severity_rank": {
    "critical": 3,
    "high": 2,
    "medium": 1,
    "low": 0
  },
  "grade_rank": {
    "broken": 0,
    "evidence-missing": 1,
    "demo": 2,
    "beta": 3,
    "production": 4
  },
