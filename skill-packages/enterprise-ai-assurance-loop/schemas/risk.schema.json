{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "enterprise-risk/v1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "owner": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "subject_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "campaign_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "accountable": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "challenger": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "mechanism": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "population": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "impact": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "knowledge": {
      "enum": [
        "OBSERVED",
        "RESEARCH_SUPPORTED",
        "HYPOTHESIS",
        "UNKNOWN"
      ]
    },
    "evidence": {
      "enum": [
        "VERIFIED_CURRENT",
        "FAILED",
        "MISSING",
        "STALE",
        "INCONCLUSIVE",
        "UNTESTABLE"
      ]
    },
    "treatment": {
      "enum": [
        "OPEN",
        "IN_PROGRESS",
        "IMPLEMENTED_UNVERIFIED",
        "MITIGATED_VERIFIED",
        "EXPLICITLY_UNADDRESSED",
        "CLOSED"
      ]
    },
    "acceptance": {
      "enum": [
        "NONE",
        "REQUESTED",
        "VALID",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "gate_effect": {
      "enum": [
        "BLOCK",
        "RESTRICT",
        "PERMIT_WITH_VALID_ACCEPTANCE",
        "NONE_WITH_CURRENT_EVIDENCE"
      ]
    },
    "exposure": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "exposure_units": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "likelihood_basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "reason_unaddressed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "review_at": {
      "type": "integer",
      "minimum": 0
    },
    "reopen_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "id",
    "owner",
    "subject_sha",
    "requirement_ids",
    "campaign_ids",
    "accountable",
    "challenger",
    "mechanism",
    "population",
    "impact",
    "knowledge",
    "evidence",
    "treatment",
    "acceptance",
    "gate_effect",
    "exposure",
    "exposure_units",
    "likelihood_basis",
    "reason_unaddressed",
    "controls",
    "evidence_refs",
    "counterevidence",
    "dependencies",
    "next_action",
    "review_at",
    "reopen_triggers"
  ],
  "additionalProperties": false
}
