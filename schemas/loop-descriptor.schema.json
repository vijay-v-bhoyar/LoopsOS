{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop Descriptor",
  "type": "object",
  "required": [
    "loop_id",
    "name",
    "version",
    "status",
    "category",
    "purpose",
    "risk",
    "authority",
    "evidence",
    "controls",
    "runtime_layers",
    "tool_policy",
    "sandbox",
    "egress",
    "identity",
    "secrets",
    "observability",
    "durability",
    "recovery",
    "kill_switch"
  ],
  "properties": {
    "loop_id": {
      "type": "string",
      "pattern": "^loop-[0-9]{3}-[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PILOT",
        "ACTIVE",
        "RESTRICTED",
        "PAUSED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "category": {
      "type": "object"
    },
    "purpose": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "authority": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "controls": {
      "type": "object"
    },
    "runtime_layers": {
      "type": "object",
      "required": ["orchestration", "durable_execution", "policy", "guardrails", "observability"],
      "properties": {
        "orchestration": {"type": "string"},
        "durable_execution": {"type": "string"},
        "policy": {"type": "string"},
        "guardrails": {"type": "string"},
        "observability": {"type": "string"}
      }
    },
    "tool_policy": {
      "type": "object",
      "required": ["allowed_action_classes", "privileged_action_rule", "policy_decision_ref_required"],
      "properties": {
        "allowed_action_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["read_only", "reversible_write", "irreversible_write", "external_effect", "financial", "security_privileged", "cross_tenant"]
          }
        },
        "privileged_action_rule": {"type": "string"},
        "policy_decision_ref_required": {"type": "boolean"}
      }
    },
    "sandbox": {
      "type": "object",
      "required": ["profile_ref", "filesystem", "privilege", "metadata_endpoint_blocked"],
      "properties": {
        "profile_ref": {"type": "string"},
        "filesystem": {"enum": ["read_only_default", "writable_workspace_only"]},
        "privilege": {"enum": ["non_privileged"]},
        "metadata_endpoint_blocked": {"type": "boolean"}
      }
    },
    "egress": {
      "type": "object",
      "required": ["default_policy", "allowed_hosts_ref", "private_network_block"],
      "properties": {
        "default_policy": {"enum": ["deny"]},
        "allowed_hosts_ref": {"type": "string"},
        "private_network_block": {"type": "boolean"}
      }
    },
    "identity": {
      "type": "object",
      "required": ["workload_identity_required", "tenant_boundary", "authorization_model"],
      "properties": {
        "workload_identity_required": {"type": "boolean"},
        "tenant_boundary": {"enum": ["required"]},
        "authorization_model": {"enum": ["RBAC_ABAC"]}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["source", "injection", "trace_redaction_required"],
      "properties": {
        "source": {"enum": ["KMS"]},
        "injection": {"enum": ["short_lived_runtime"]},
        "trace_redaction_required": {"type": "boolean"}
      }
    },
    "observability": {
      "type": "object",
      "required": ["trace_sink_ref", "audit_sink_ref", "redaction_proof_required"],
      "properties": {
        "trace_sink_ref": {"type": "string"},
        "audit_sink_ref": {"type": "string"},
        "redaction_proof_required": {"type": "boolean"}
      }
    },
    "durability": {
      "type": "object",
      "required": ["workflow_adapter_ref", "idempotency_scope", "retry_budget"],
      "properties": {
        "workflow_adapter_ref": {"type": "string"},
        "idempotency_scope": {"type": "string"},
        "retry_budget": {"type": "object"}
      }
    },
    "recovery": {
      "type": "object",
      "required": ["mode", "reconciliation_required", "compensation_required_for_external_effect"],
      "properties": {
        "mode": {"enum": ["bounded_retry_then_block_or_compensate"]},
        "reconciliation_required": {"type": "boolean"},
        "compensation_required_for_external_effect": {"type": "boolean"}
      }
    },
    "kill_switch": {
      "type": "object",
      "required": ["scopes", "activation_record_required"],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["tenant", "agent", "tool", "global"]}
        },
        "activation_record_required": {"type": "boolean"}
      }
    }
  }
}
