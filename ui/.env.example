# Evaluation is the only mode that can run without authoritative enterprise services.
VITE_LOOPOS_DEPLOYMENT_MODE=evaluation
VITE_LOOPOS_ENVIRONMENT_NAME=Local evaluation

# Enterprise activation contract. Set all values in a controlled build pipeline.
# The UI remains blocked until runtime identity, persistence, and audit probes also pass.
VITE_LOOPOS_AUTHORITY_URL=https://loopos.example.com/api
VITE_LOOPOS_AUTH_MODE=bff-session
VITE_LOOPOS_PERSISTENCE_MODE=api
VITE_LOOPOS_AUDIT_MODE=server
VITE_LOOPOS_RETENTION_POLICY_URL=https://policy.example.com/loopos-retention
VITE_LOOPOS_SUPPORT_CONTACT=loopos-operations@example.com
VITE_LOOPOS_OUTBOUND_POLICY_MODE=allowlist
VITE_LOOPOS_ALLOWED_ENDPOINT_HOSTS=ai.example.com,transcription.example.com
VITE_LOOPOS_BACKUP_RESTORE_EVIDENCE_URL=https://evidence.example.com/loopos/restore-test

# Optional, explicitly invoked services. Never place credentials in VITE_ variables.
VITE_LOOPOS_LLM_ENDPOINT=https://ai.example.com/loopos
VITE_LOOPOS_TRANSCRIPTION_ENDPOINT=https://transcription.example.com/audio

# Prefer the same-origin value /api when the production ingress routes that path
# to the authority service.
