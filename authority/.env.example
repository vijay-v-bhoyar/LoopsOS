# Default beta/evaluation persistence. No Supabase or Docker required.
# LOOPOS_REPO_ROOT=/absolute/path/to/LoopOS
LOOPOS_STORAGE_BACKEND=sqlite
LOOPOS_DATABASE_PATH=authority/data/loopos-authority.db

# Local Supabase/Postgres beta persistence.
# Requires Supabase CLI plus Docker or a compatible container runtime.
# LOOPOS_STORAGE_BACKEND=postgres
# LOOPOS_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:54322/postgres

LOOPOS_ALLOW_DEV_AUTH=true
LOOPOS_SESSION_HMAC_SECRET=loopos-local-development-secret-change-before-production
LOOPOS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOOPOS_ALLOWED_HTTP_HOSTS=

# Required in production. Counters are persisted in the authority database.
# LOOPOS_RATE_LIMIT_REQUESTS=120
# LOOPOS_RATE_LIMIT_WINDOW_SECONDS=60

# Production identity. Disable development auth and bind all OIDC values together.
# The identity-aware gateway may provide the signed assertion in the
# x-loopos-identity-token header or the secure, HttpOnly loopos_identity cookie.
# LOOPOS_ALLOW_DEV_AUTH=false
# LOOPOS_OIDC_ISSUER=https://identity.example.com/
# LOOPOS_OIDC_AUDIENCE=loopos-production
# LOOPOS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# LOOPOS_OIDC_TENANT_CLAIM=tenant_id
# LOOPOS_OIDC_ROLE_CLAIM=groups
# LOOPOS_OIDC_ROLE_MAPPING_JSON={"loopos-executives":"Executive","loopos-approvers":"Approver","loopos-operators":"Operator","loopos-auditors":"Auditor"}

# External append-only audit anchor. The sink must deduplicate x-loopos-event-id,
# verify x-loopos-signature-256 over the exact request bytes, and retain records
# under the approved WORM/SIEM policy.
# LOOPOS_AUDIT_ANCHOR_URL=https://audit.example.com/loopos/events
# LOOPOS_AUDIT_ANCHOR_HMAC_SECRET=replace-with-at-least-32-random-bytes
# LOOPOS_AUDIT_ANCHOR_POLL_SECONDS=5
# LOOPOS_AUDIT_ANCHOR_DELIVERY_MAX_AGE_SECONDS=300

# Production operations. A deny-all outbound policy is valid; allowlist mode
# requires LOOPOS_ALLOWED_HTTP_HOSTS. Restore evidence must be recent.
# LOOPOS_RETENTION_POLICY_URL=https://policy.example.com/loopos-retention
# LOOPOS_SUPPORT_CONTACT=loopos-operations@example.com
# LOOPOS_OUTBOUND_POLICY_MODE=allowlist
# LOOPOS_BACKUP_RESTORE_EVIDENCE_URL=https://evidence.example.com/loopos/restore-test
# LOOPOS_BACKUP_RESTORE_EVIDENCE_SHA256=<lowercase-sha256-of-exact-restore-evidence-json>
# LOOPOS_BACKUP_RESTORE_VERIFIED_AT=2026-07-30T00:00:00+00:00
# LOOPOS_BACKUP_RESTORE_MAX_AGE_DAYS=90
# LOOPOS_OPERATIONAL_EVIDENCE_URL=https://evidence.example.com/loopos/operational-controls.json
# LOOPOS_OPERATIONAL_EVIDENCE_SHA256=<lowercase-sha256-of-exact-operational-evidence-json>
# LOOPOS_OPERATIONAL_EVIDENCE_VERIFIED_AT=2026-07-30T00:00:00+00:00
# LOOPOS_OPERATIONAL_EVIDENCE_MAX_AGE_DAYS=90

# Durable execution worker. The token protects the serverless/cron drain route.
# LOOPOS_WORKER_TOKEN=replace-with-at-least-32-random-bytes
# CRON_SECRET is the Vercel-compatible fallback for LOOPOS_WORKER_TOKEN.
# CRON_SECRET=replace-with-at-least-32-random-bytes
# VERCEL=1 is injected by Vercel and must not be set manually elsewhere.
# Use internal for a long-lived authority process. Vercel defaults to external,
# where the protected cron route must report a fresh heartbeat.
# LOOPOS_EXECUTION_WORKER_MODE=internal
# LOOPOS_EXECUTION_WORKER_POLL_SECONDS=0.25
# LOOPOS_EXECUTION_WORKER_HEARTBEAT_MAX_AGE_SECONDS=180
# LOOPOS_EXECUTION_JOB_LEASE_SECONDS=120
# LOOPOS_EXECUTION_JOB_MAX_ATTEMPTS=5

# Optional local-development connector credentials and webhook verification secrets.
# Production connector credentials must come from an approved short-lived
# credential-injection broker; static bearer tokens fail readiness and dispatch.
# Every local connector token hostname must also appear in LOOPOS_ALLOWED_HTTP_HOSTS.
# LOOPOS_CONNECTOR_BEARER_TOKENS_JSON={"api.example.com":"secret-from-managed-vault"}
# LOOPOS_WEBHOOK_SECRETS_JSON={"tenant-id:github":"secret-from-managed-vault"}
